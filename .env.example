# Copy this file to .env and fill in every value.

# Login for the dashboard. The account is created on first start; changing
# these later does not change an existing account's password.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-something-long

# Database password. Letters and numbers only, e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=

# Encrypts stored API keys and database passwords. Generate with:
#   openssl rand -base64 32
# Back this up: if it's lost, saved keys and passwords can't be decrypted.
MASTER_KEY=

# Port the dashboard is served on: http://localhost:8080
APP_PORT=8080

# Set to true once the dashboard is served over HTTPS.
COOKIE_SECURE=false

# Embedding model pulled into Ollama automatically.
EMBEDDING_MODEL=embeddinggemma
